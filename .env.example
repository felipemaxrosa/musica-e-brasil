# === Site ===
# URL pública do site (temporária na Vercel por ora). Usada em metadataBase/canonical/OG/sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === Sanity (projeto novo, conta pessoal, plano free) ===
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-21
# Token somente-leitura (server) para sanityFetch
SANITY_API_READ_TOKEN=
# Token de escrita (server) para gravar o lead do formulário de agendamento
SANITY_API_WRITE_TOKEN=

# === Resend (envio do e-mail de agendamento) ===
RESEND_API_KEY=
# Destino das solicitações de agendamento (a confirmar com a escola)
CONTACT_TO_EMAIL=
# Remetente: enquanto não houver domínio verificado, usar o de teste do Resend
RESEND_FROM_EMAIL=onboarding@resend.dev
